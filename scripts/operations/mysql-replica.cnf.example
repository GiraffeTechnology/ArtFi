# M6.2 source-neutral MySQL 8.4 replica template.
# The replica remains read-only across restart and source outages.
# Replication connection/account/TLS configuration is a separate operator step.
[mysqld]
server-id=REPLICA_UNIQUE_SERVER_ID
bind-address=PRIVATE_SERVICE_BIND_ADDRESS
port=ALLOCATED_MYSQL_PORT
datadir=/OPERATOR_PROVISIONED/mysql-replica
log-bin=/OPERATOR_PROVISIONED/mysql-replica/binlog
relay-log=/OPERATOR_PROVISIONED/mysql-replica/relay
binlog-format=ROW
gtid-mode=ON
enforce-gtid-consistency=ON
log-replica-updates=ON
sync-binlog=1
innodb-flush-log-at-trx-commit=1
binlog-expire-logs-seconds=604800
relay-log-recovery=ON
read-only=ON
super-read-only=ON
mysqlx=OFF
# Supply operator-approved server certificate/key/CA paths before real use.
require-secure-transport=ON
ssl-ca=/OPERATOR_PROVISIONED/tls/ca.pem
ssl-cert=/OPERATOR_PROVISIONED/tls/server-cert.pem
ssl-key=/OPERATOR_PROVISIONED/tls/server-key.pem
