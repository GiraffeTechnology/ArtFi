ARTFI_ENV=development
ARTFI_WEB_URL=http://localhost:3000
ARTFI_API_ADDR=:8080
ARTFI_CHAIN_ID=11155111
ARTFI_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

MYSQL_DATABASE=artfi
MYSQL_USER=artfi
MYSQL_PASSWORD=local-artfi-only
MYSQL_ROOT_PASSWORD=local-root-only
MYSQL_DSN=artfi:local-artfi-only@tcp(localhost:3306)/artfi?parseTime=true
REDIS_URL=redis://localhost:6379/0

# Never place production credentials in this file or commit them to Git.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Stage 2 write path stays disabled until every value is reviewed and present.
ARTFI_OBJECT_PUBLIC_BASE_URL=
ARTFI_RWA_REGISTRY_ADDRESS=
ARTFI_VAULT_FACTORY_ADDRESS=
ARTFI_INDEXER_SHARED_KEY=
ARTFI_OPERATOR_BEARER_TOKEN=

# External marketplace mirroring is read-only. Sources not listed here are rejected.
ARTFI_MARKETPLACE_ALLOWLIST=opensea
ARTFI_API_URL=http://localhost:8080
OPENSEA_API_KEY=
OPENSEA_COLLECTION_SLUGS=
OPENSEA_BACKFILL_PAGES=2
OPENSEA_STREAM_STORAGE_PATH=.opensea-stream

# Optional browser configuration. Defaults remain Sepolia/read-only.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Local offline test signer only. Set the absolute path in the process environment;
# never place a key value or a user-specific path in this file.
ARTFI_TEST_PRIVATE_KEY_FILE=
