ARTFI_ENV=development
ARTFI_WEB_URL=http://localhost:3000
ARTFI_API_ADDR=:8080
ARTFI_CHAIN_ID=560048
# Inject only on the Singapore public-chain runner. No repository default is allowed.
ARTFI_PUBLIC_CHAIN_EXECUTION_ZONE=
ARTFI_RPC_URL=

MYSQL_DATABASE=artfi
MYSQL_USER=artfi
MYSQL_PASSWORD=local-artfi-only
MYSQL_ROOT_PASSWORD=local-root-only
MYSQL_DSN=artfi:local-artfi-only@tcp(localhost:3306)/artfi?parseTime=true
REDIS_URL=redis://localhost:6379/0

# Never place production credentials in this file or commit them to Git.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Stage 2 write path stays disabled until every value is reviewed and present.
ARTFI_OBJECT_PUBLIC_BASE_URL=
ARTFI_RWA_REGISTRY_ADDRESS=
ARTFI_VAULT_FACTORY_ADDRESS=
ARTFI_INDEXER_SHARED_KEY=
ARTFI_OPERATOR_BEARER_TOKEN=
# Server-only administrator gateway settings. Never expose these as NEXT_PUBLIC_*.
ARTFI_OPERATOR_API_URL=
ARTFI_OPERATOR_SESSION_SECRET=
# Charity-edition holder verification (#110 §2 CH.5/CH.6). At least 32 characters.
ARTFI_CHARITY_HOLDER_SESSION_SECRET=
ARTFI_CHARITY_EDITIONS_ADDRESS=
# Reviewed watermarked-holder descriptor store. Masters are never referenced here.
ARTFI_CHARITY_HOLDER_ASSET_MANIFEST=
# Private store holding the watermarked holder files (CH.5). Separate from the R2_* bucket above
# on purpose: that one is published under a public base URL, and a charity holder file must never
# be publicly reachable (CH.6). Unset means holder delivery reports itself unavailable.
ARTFI_CHARITY_HOLDER_OBJECT_ENDPOINT=
ARTFI_CHARITY_HOLDER_OBJECT_REGION=auto
ARTFI_CHARITY_HOLDER_OBJECT_BUCKET=
ARTFI_CHARITY_HOLDER_OBJECT_ACCESS_KEY_ID=
ARTFI_CHARITY_HOLDER_OBJECT_SECRET_ACCESS_KEY=

# External marketplace mirroring is read-only and may run only in the SIN execution zone.
# Sources not listed here are rejected.
ARTFI_MARKETPLACE_ALLOWLIST=opensea
ARTFI_API_URL=http://localhost:8080
OPENSEA_API_KEY=
OPENSEA_COLLECTION_SLUGS=
OPENSEA_STREAM_STORAGE_PATH=.opensea-stream

# Fail-closed external execution gate. Enable only after legal/security approval and
# an OpenSea API key are present; ArtFi never receives a signing key.
ARTFI_EXTERNAL_TRADE_ENABLED=false

# Optional browser configuration. Defaults remain Hoodi/read-only.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_HOODI_RPC_URL=
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_EXTERNAL_TRADE_ENABLED=false
# Public Hoodi contract address only; never place a signer or credential here.
NEXT_PUBLIC_ARTFI_CHARITY_EDITIONS_ADDRESS=

# DAO writes fail closed unless all four reviewed Hoodi deployment addresses are present.
NEXT_PUBLIC_ARTFI_GOVERNOR_ADDRESS=
NEXT_PUBLIC_ARTFI_GOVERNANCE_TOKEN_ADDRESS=
NEXT_PUBLIC_ARTFI_DAO_ACTIONS_ADDRESS=
NEXT_PUBLIC_ARTFI_RWA_VAULT_ADDRESS=
ARTFI_DAO_ACTIONS_ADDRESS=
ARTFI_GOVERNOR_ADDRESS=
ARTFI_GOVERNANCE_TOKEN_ADDRESS=
ARTFI_RWA_VAULT_ADDRESS=

# Hoodi governance deployment tooling. The proposal threshold is fixed on-chain at 10%.
ARTFI_RWA_VAULT=
ARTFI_BUYOUT_PRICE_VERIFIER=
ARTFI_TIMELOCK_DELAY_SECONDS=
ARTFI_VOTING_DELAY_BLOCKS=
ARTFI_VOTING_PERIOD_BLOCKS=
ARTFI_QUORUM_PERCENT=

# Local offline test signer only. Set the absolute path in the process environment;
# never place a key value or a user-specific path in this file.
ARTFI_TEST_PRIVATE_KEY_FILE=
