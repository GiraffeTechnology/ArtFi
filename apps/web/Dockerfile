ARG NODE_IMAGE=node:24.18.0-bookworm-slim

FROM ${NODE_IMAGE} AS build

ENV NEXT_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

# Browser settings are embedded by Next.js during this build, not at container startup.
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_ARTFI_CHARITY_EDITIONS_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_DAO_ACTIONS_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_FRACTION_MARKET_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_FRACTION_SLUG=""
ARG NEXT_PUBLIC_ARTFI_FRACTION_TOKEN_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_GOVERNANCE_TOKEN_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_GOVERNOR_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_RWA_VAULT_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_COLLECTION_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_MARKET_ADDRESS=""
ARG NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_SLUG=""
ARG NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_TOKEN_ID=""
ARG NEXT_PUBLIC_ETHEREUM_RPC_URL=""
ARG NEXT_PUBLIC_HOODI_RPC_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_ARTFI_CHARITY_EDITIONS_ADDRESS=$NEXT_PUBLIC_ARTFI_CHARITY_EDITIONS_ADDRESS \
    NEXT_PUBLIC_ARTFI_DAO_ACTIONS_ADDRESS=$NEXT_PUBLIC_ARTFI_DAO_ACTIONS_ADDRESS \
    NEXT_PUBLIC_ARTFI_FRACTION_MARKET_ADDRESS=$NEXT_PUBLIC_ARTFI_FRACTION_MARKET_ADDRESS \
    NEXT_PUBLIC_ARTFI_FRACTION_SLUG=$NEXT_PUBLIC_ARTFI_FRACTION_SLUG \
    NEXT_PUBLIC_ARTFI_FRACTION_TOKEN_ADDRESS=$NEXT_PUBLIC_ARTFI_FRACTION_TOKEN_ADDRESS \
    NEXT_PUBLIC_ARTFI_GOVERNANCE_TOKEN_ADDRESS=$NEXT_PUBLIC_ARTFI_GOVERNANCE_TOKEN_ADDRESS \
    NEXT_PUBLIC_ARTFI_GOVERNOR_ADDRESS=$NEXT_PUBLIC_ARTFI_GOVERNOR_ADDRESS \
    NEXT_PUBLIC_ARTFI_RWA_VAULT_ADDRESS=$NEXT_PUBLIC_ARTFI_RWA_VAULT_ADDRESS \
    NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_COLLECTION_ADDRESS=$NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_COLLECTION_ADDRESS \
    NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_MARKET_ADDRESS=$NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_MARKET_ADDRESS \
    NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_SLUG=$NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_SLUG \
    NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_TOKEN_ID=$NEXT_PUBLIC_ARTFI_WHOLE_ARTWORK_TOKEN_ID \
    NEXT_PUBLIC_ETHEREUM_RPC_URL=$NEXT_PUBLIC_ETHEREUM_RPC_URL \
    NEXT_PUBLIC_HOODI_RPC_URL=$NEXT_PUBLIC_HOODI_RPC_URL

RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @giraffetechnology/artfi-web build \
    && cp -a /app/node_modules/.pnpm/@swc+helpers@* \
      /app/apps/web/.next/standalone/node_modules/.pnpm/

FROM ${NODE_IMAGE} AS runtime

ARG ARTFI_BUILD_SHA=""
LABEL org.opencontainers.image.revision=$ARTFI_BUILD_SHA
ENV ARTFI_BUILD_SHA=$ARTFI_BUILD_SHA

ENV HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public

USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "apps/web/server.js"]
